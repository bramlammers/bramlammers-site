---
import '@fontsource/young-serif/400.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/site.css';
import instellingen from '../content/instellingen.json';

interface Props { titel: string; omschrijving?: string; thuis?: boolean }
const { titel, omschrijving = '', thuis = false } = Astro.props;
const voorbeeld = instellingen.voorbeeldbalk;
// on sub-pages the menu links point back to the homepage sections
const h = (anker: string) => (thuis ? `#${anker}` : `/#${anker}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    {omschrijving && <meta name="description" content={omschrijving} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    {omschrijving && <meta property="og:description" content={omschrijving} />}
    <meta property="og:locale" content="nl_NL" />
    <meta name="theme-color" content="#F3EDE2" />
    {voorbeeld && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion', 'loading');
          setTimeout(function () { d.classList.remove('loading'); }, 2200);
        }
      })();
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a class="skip" href="#inhoud">Naar de inhoud</a>
    {voorbeeld && <div class="preview"><i aria-hidden="true"></i>Voorbeeldversie · nog niet online</div>}

    <header class="site-head">
      <div class="wrap">
        <a class="logo" href={thuis ? '#top' : '/'} id="top" data-h>Bram Lammers</a>
        <nav class="nav" id="nav" aria-label="Hoofdmenu">
          <a href={h('werkwijze')} data-h>Werkwijze</a>
          <a href={h('aanbod')} data-h>Aanbod</a>
          <a href={h('maandradar')} data-h>Maandradar</a>
          <a href={h('over')} data-h>Over</a>
        </nav>
        <a class="btn head-cta" href={h('kennismaken')} data-h>Even kennismaken</a>
        <button class="btn btn--line menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-h>Menu</button>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <a class="logo" href="/">Bram Lammers</a>
        <ul>
          {instellingen.email && <li><a href={`mailto:${instellingen.email}`}>{instellingen.email}</a></li>}
          <li>{instellingen.kvk ? `KVK ${instellingen.kvk}` : 'KVK volgt'}</li>
          <li><a href="/privacy">Privacyverklaring</a></li>
          {instellingen.linkedin && <li><a href={instellingen.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>}
        </ul>
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
