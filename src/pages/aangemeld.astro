---
// Hier komt iemand uit als de maandradar-aanmelding zonder JavaScript wordt verstuurd.
import Base from '../layouts/Base.astro';
import home from '../content/home.json';
---
<Base titel="Aangemeld · Bram Lammers">
  <section class="page">
    <div class="wrap">
      <p class="label">Maandradar</p>
      <h1 class="h2">Je bent er bijna.</h1>
      <p class="lead">{home.maandradar.bedankt}</p>
      <p><a class="btn btn--line" href="/">Terug naar de homepage</a></p>
    </div>
  </section>
</Base>
